---
import Base from '../layouts/Base.astro';
import { listBlogs, listPages } from '../lib/data';
import { getBlogPermalink, getPageRouteSlug } from '../lib/permalinks';

export const prerender = false;

const pages = await listPages();
const posts = await listBlogs();

const title = 'Sitemap | Web News Release';
const description = 'Browse the public pages and latest reporting published by Web News Release.';

function cleanTitle(value: unknown, fallback = 'Untitled') {
  return typeof value === 'string' && value.trim() ? value.trim() : fallback;
}

function withTrailingSlash(value: string) {
  if (!value || value === '/') return '/';
  const normalized = value.startsWith('/') ? value : '/' + value;
  return normalized.endsWith('/') ? normalized : normalized + '/';
}

function pageUrl(page: any) {
  const filename = page?._sys?.filename || '';
  if (filename === 'home') return '/';
  return withTrailingSlash(getPageRouteSlug(page) || filename);
}

function postUrl(post: any) {
  return withTrailingSlash(getBlogPermalink(post));
}

function isHiddenPage(page: any) {
  const filename = page?._sys?.filename || '';
  const url = pageUrl(page);
  return Boolean(
    page?.draft ||
    page?.seo?.noindex ||
    filename === '404' ||
    filename === 'sitemap' ||
    url === '/sitemap/'
  );
}

function isHiddenPost(post: any) {
  return Boolean(post?.draft || post?.seo?.noindex);
}

type SitemapLink = { title: string; url: string };
type SitemapPostLink = SitemapLink & { date: Date | null };

const pageLinks: SitemapLink[] = (pages as any[])
  .filter((page: any) => !isHiddenPage(page))
  .map((page: any): SitemapLink => ({
    title: cleanTitle(page.title || page.seoTitle || page.seo?.metaTitle, page?._sys?.filename || 'Page'),
    url: pageUrl(page),
  }))
  .sort((a: SitemapLink, b: SitemapLink) => {
    if (a.url === '/') return -1;
    if (b.url === '/') return 1;
    return a.title.localeCompare(b.title);
  });

const postLinks: SitemapPostLink[] = (posts as any[])
  .filter((post: any) => !isHiddenPost(post))
  .map((post: any): SitemapPostLink => ({
    title: cleanTitle(post.title || post.seo?.metaTitle, post?._sys?.filename || 'Story'),
    url: postUrl(post),
    date: post.pubDate ? new Date(post.pubDate) : null,
  }))
  .sort((a: SitemapPostLink, b: SitemapPostLink) => Number(b.date || 0) - Number(a.date || 0));

const totalLinks = pageLinks.length + postLinks.length;
---

<Base
  title={title}
  description={description}
  ogTitle={title}
  ogDescription={description}
  canonicalUrl="/sitemap/"
>
  <main class="wnr-sitemap" aria-labelledby="sitemap-title">
    <header class="sm-hero">
      <div class="sm-hero__main">
        <span class="sm-kicker">Site directory</span>
        <h1 id="sitemap-title">Sitemap</h1>
        <p>Find every public page and the latest published reporting from Web News Release. This directory updates automatically with the live content collections.</p>
      </div>
      <div class="sm-hero__stats" aria-label="Sitemap totals">
        <div><strong>{pageLinks.length}</strong><span>Public pages</span></div>
        <div><strong>{postLinks.length}</strong><span>Published stories</span></div>
        <div><strong>{totalLinks}</strong><span>Total links</span></div>
      </div>
    </header>

    <section class="sm-overview" aria-labelledby="sitemap-overview-title">
      <div class="sm-wrap sm-overview__inner">
        <div>
          <span class="sm-eyebrow"><i></i>Live site index</span>
          <h2 id="sitemap-overview-title">Everything published, in one place.</h2>
        </div>
        <p>The lists below use the same Tina-backed page and story data as the rest of the website. Published content appears here automatically, while drafts and pages marked noindex stay out.</p>
      </div>
    </section>

    <section class="sm-directory" aria-label="Website directory">
      <div class="sm-wrap">
        <section class="sm-panel" aria-labelledby="sitemap-pages-title">
          <header class="sm-panel__header">
            <div>
              <span class="sm-panel__kicker">Browse the publication</span>
              <h2 id="sitemap-pages-title">Website pages</h2>
            </div>
            <b>{pageLinks.length} links</b>
          </header>
          {pageLinks.length > 0 ? (
            <ol class="sm-page-grid">
              {pageLinks.map((item: SitemapLink, index: number) => (
                <li>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <a href={item.url}>{item.title}</a>
                </li>
              ))}
            </ol>
          ) : (
            <p class="sm-empty">No public pages found.</p>
          )}
        </section>

        <section class="sm-panel sm-panel--stories" aria-labelledby="sitemap-posts-title">
          <header class="sm-panel__header">
            <div>
              <span class="sm-panel__kicker">From the newsroom</span>
              <h2 id="sitemap-posts-title">Latest stories</h2>
            </div>
            <b>{postLinks.length} links</b>
          </header>
          {postLinks.length > 0 ? (
            <ol class="sm-story-list">
              {postLinks.map((item: SitemapPostLink, index: number) => (
                <li>
                  <span class="sm-story-list__number">{String(index + 1).padStart(2, '0')}</span>
                  <div>
                    <a href={item.url}>{item.title}</a>
                    {item.date && <time datetime={item.date.toISOString()}>{item.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>}
                  </div>
                </li>
              ))}
            </ol>
          ) : (
            <p class="sm-empty">No published stories found.</p>
          )}
        </section>
      </div>
    </section>
  </main>
</Base>
