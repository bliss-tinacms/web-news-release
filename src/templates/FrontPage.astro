---
import { tinaField } from '@tinacms/astro/tina-field';
import { getBlogPermalink } from '../lib/permalinks';

interface Props {
  posts?: unknown[];
  config?: unknown;
  data?: any;
  editData?: any;
}

const { posts = [], data, editData } = Astro.props;
const publicBlocks = Array.isArray(data?.blocks) ? data.blocks : [];
const editBlocks = Array.isArray(editData?.blocks) ? editData.blocks : [];
const isHomepage = (block: any) => block?._template === 'homepageTemplate' || block?.__typename === 'PageBlocksHomepageTemplate';
const homepage = publicBlocks.find(isHomepage) ?? {};
const editHomepage = editBlocks.find(isHomepage) ?? homepage;

function tf(node: any, key: string) {
  try { return node ? tinaField(node, key) : undefined; }
  catch { return undefined; }
}

const hero = homepage.hero ?? {};
const latest = homepage.latest ?? {};
const mission = homepage.mission ?? {};
const coverage = homepage.coverage ?? {};
const quote = homepage.quote ?? {};
const standards = homepage.standards ?? {};
const team = homepage.team ?? {};
const editHero = editHomepage.hero ?? hero;
const editLatest = editHomepage.latest ?? latest;
const editMission = editHomepage.mission ?? mission;
const editCoverage = editHomepage.coverage ?? coverage;
const editQuote = editHomepage.quote ?? quote;
const editStandards = editHomepage.standards ?? standards;
const editTeam = editHomepage.team ?? team;

function referenceLabel(reference: unknown): string {
  const first = Array.isArray(reference) ? reference[0] : reference;
  if (!first) return 'NEWS';
  if (typeof first === 'string') {
    const value = first.split('/').pop()?.replace(/\.(json|mdx?)$/i, '').replace(/-/g, ' ') || 'NEWS';
    return value.replace(/\b\w/g, (letter) => letter.toUpperCase());
  }
  if (typeof first === 'object') {
    const item = first as any;
    return item.title || item.name || item.category?.title || item.category?.name || referenceLabel(item.category);
  }
  return 'NEWS';
}

function storyDate(value: unknown) {
  if (!value) return '';
  const date = new Date(String(value));
  return Number.isNaN(date.valueOf())
    ? ''
    : new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' }).format(date);
}

const latestPosts = (Array.isArray(posts) ? posts : []).slice(0, 3).map((post: any) => ({
  source: post,
  link: getBlogPermalink(post),
  image: post.heroImage || '/placeholder.jpg',
  imageAlt: post.heroImageAlt || post.title || 'Article image',
  category: referenceLabel(post.categories),
  meta: storyDate(post.pubDate || post.updatedDate),
  title: post.title || 'Untitled story',
  description: post.description || 'Read the full report.',
}));
const latestStories = latestPosts.length ? latestPosts : (latest.items ?? []);
---

  <section class="hero" aria-labelledby="home-hero-title">
    <div class="hero-panel">
      <span class="hero-tag" data-tina-field={tf(editHero, 'tag')}>{hero.tag}</span>
      <h1 id="home-hero-title" data-tina-field={tf(editHero, 'title')}>{hero.title}</h1>
      <p class="hero-d" data-tina-field={tf(editHero, 'description')}>{hero.description}</p>
    </div>
    <div class="hero-shot">
      <div class="hero-img" role="img" aria-label={hero.imageAlt || ''} style={hero.image ? `background-image:url('${hero.image}')` : undefined} data-tina-field={tf(editHero, 'image')}></div>
    </div>
  </section>

  <section class="fd" aria-labelledby="latest-stories-title"><div class="w">
    <div class="fd-h"><b id="latest-stories-title" data-tina-field={tf(editLatest, 'title')}>{latest.title}</b><span data-tina-field={tf(editLatest, 'updatedLabel')}>{latest.updatedLabel}</span></div>
    <div class="fd-g">
      {latestStories.map((item: any, index: number) => {
        const editItem = item.source ?? editLatest?.items?.[index] ?? item;
        return <a href={item.link || '#'} class="fdi">
          <div class="fdi-img" role="img" aria-label={item.imageAlt || ''} style={item.image ? `background-image:url('${item.image}')` : undefined} data-tina-field={tf(editItem, 'image')}></div>
          <div class="fdi-c">
            <div class="fdi-t"><span data-tina-field={tf(editItem, 'category')}>{item.category}</span><em data-tina-field={tf(editItem, 'meta')}>{item.meta}</em></div>
            <div class="fdi-h" data-tina-field={tf(editItem, 'title')}>{item.title}</div>
            <p class="fdi-x" data-tina-field={tf(editItem, 'description')}>{item.description}</p>
          </div>
        </a>;
      })}
    </div>
  </div></section>

  <section class="ms" aria-labelledby="mission-title"><div class="w">
    <div class="ms-hd">
      <div class="eye"><i></i><span data-tina-field={tf(editMission, 'eyebrow')}>{mission.eyebrow}</span></div>
      <h2 class="ms-st" id="mission-title" data-tina-field={tf(editMission, 'title')}>{mission.title}</h2>
      <div class="ms-rule"></div>
    </div>
    <div class="ms-col">
      {(mission.paragraphs ?? []).map((item: any, index: number) => {
        const editItem = editMission?.paragraphs?.[index] ?? item;
        return item.bold
          ? <p><b data-tina-field={tf(editItem, 'text')}>{item.text}</b></p>
          : <p data-tina-field={tf(editItem, 'text')}>{item.text}</p>;
      })}
    </div>
    <div class="ms-sig"><i></i><span data-tina-field={tf(editMission, 'signature')}>{mission.signature}</span><i></i></div>
  </div></section>

  <section class="cv" aria-labelledby="coverage-title"><div class="w">
    <div class="eye"><i></i><span data-tina-field={tf(editCoverage, 'eyebrow')}>{coverage.eyebrow}</span></div>
    <h2 class="h2" id="coverage-title" data-tina-field={tf(editCoverage, 'title')}>{coverage.title}</h2>
    <div class="cv-g">
      {(coverage.items ?? []).map((item: any, index: number) => {
        const editItem = editCoverage?.items?.[index] ?? item;
        return <a href={item.link || '#'} class="cvi"><div class="cvi-n"><span data-tina-field={tf(editItem, 'number')}>{item.number}</span> / <span data-tina-field={tf(editItem, 'label')}>{item.label}</span></div><div class="cvi-t" data-tina-field={tf(editItem, 'title')}>{item.title}</div><p class="cvi-x" data-tina-field={tf(editItem, 'text')}>{item.text}</p></a>;
      })}
    </div>
  </div></section>

  <section class="qt"><div class="qt-in">
    <div class="qt-img" role="img" aria-label={quote.imageAlt || ''} style={quote.image ? `background-image:url('${quote.image}')` : undefined} data-tina-field={tf(editQuote, 'image')}></div>
    <div class="qt-b">
      <div class="qt-m" data-tina-field={tf(editQuote, 'eyebrow')}>{quote.eyebrow}</div>
      <p class="qt-q" data-tina-field={tf(editQuote, 'quote')}>{quote.quote}</p>
      <div class="qt-by"><div class="qt-n" data-tina-field={tf(editQuote, 'author')}>{quote.author}</div><div class="qt-r" data-tina-field={tf(editQuote, 'byline')}>{quote.byline}</div></div>
    </div>
  </div></section>

  <section class="st" aria-labelledby="standards-title"><div class="w">
    <div class="eye"><i></i><span data-tina-field={tf(editStandards, 'eyebrow')}>{standards.eyebrow}</span></div>
    <h2 class="h2" id="standards-title" data-tina-field={tf(editStandards, 'title')}>{standards.title}</h2>
    <div class="st-g">
      {(standards.items ?? []).map((item: any, index: number) => {
        const editItem = editStandards?.items?.[index] ?? item;
        return <div class="stf"><div class="stf-tab"><span data-tina-field={tf(editItem, 'tab')}>{item.tab}</span></div><div class="stf-b"><div class="stf-n" data-tina-field={tf(editItem, 'number')}>{item.number}</div><p data-tina-field={tf(editItem, 'text')}>{item.text}</p></div></div>;
      })}
    </div>
    <div class="st-seal"><i></i><p data-tina-field={tf(editStandards, 'seal')}>{standards.seal}</p></div>
  </div></section>

  <section class="tm" aria-labelledby="team-title"><div class="w">
    <div class="eye"><i></i><span data-tina-field={tf(editTeam, 'eyebrow')}>{team.eyebrow}</span></div>
    <h2 class="h2" id="team-title" data-tina-field={tf(editTeam, 'title')}>{team.title}</h2>
    <div class="tm-g">
      {(team.members ?? []).map((member: any, index: number) => {
        const editMember = editTeam?.members?.[index] ?? member;
        return <a href={member.link || '#'} class="tmi"><img class="tmi-img" src={member.image} alt={member.imageAlt || member.name || ''} data-tina-field={tf(editMember, 'image')} /><div class="tmi-b"><div class="tmi-n" data-tina-field={tf(editMember, 'name')}>{member.name}</div><div class="tmi-r" data-tina-field={tf(editMember, 'role')}>{member.role}</div><p class="tmi-x" data-tina-field={tf(editMember, 'text')}>{member.text}</p></div></a>;
      })}
    </div>
  </div></section>
