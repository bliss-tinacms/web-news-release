---
import { tinaField } from '@tinacms/astro/tina-field';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { getEditablePage, getFooterNavigation, getPublicPage, type CmsConfig } from '../lib/data';
import FooterCta from './FooterCta.astro';

type NavItem = {
  label?: string | null;
  href?: string | null;
  children?: (NavItem | null)[] | null;
};

type NavigationDocument = {
  title?: string | null;
  items?: (NavItem | null)[] | null;
};

interface Props {
  config?: CmsConfig | null;
  navigation?: NavigationDocument | null;
}

const { config } = Astro.props;
let { navigation } = Astro.props;
if (!navigation && config) navigation = (await getFooterNavigation(config)).data?.navigation ?? null;
const seo = config?.seo ?? null;
const branding = (config as any)?.branding ?? null;
const siteTitle = seo?.title || '';
const footerLogo = seo?.footerLogo || seo?.logo || '';
const footerDescription = branding?.footerDescription || '';
const copyright = branding?.copyright || '';
const currentYear = new Date().getFullYear();
const dynamicCopyright = (() => {
  const value = String(copyright || '').trim();
  if (!value) return `© ${currentYear} ${siteTitle}. All rights reserved.`;
  if (/\b(?:19|20)\d{2}\b/.test(value)) {
    return value.replace(/\b(?:19|20)\d{2}\b/g, String(currentYear));
  }
  if (value.startsWith('©')) return value.replace(/^©\s*/, `© ${currentYear} `);
  return `© ${currentYear} ${value}`;
})();
const footerColumns = ((navigation?.items ?? []) as NavItem[]).filter((item) => item?.label && item?.children?.length);
const footerPage = await getPublicPage('home');
const editableFooterPage = await getEditablePage('home');
const footerPageData = footerPage.data?.page ?? null;
const editableFooterPageData = editableFooterPage.data?.page ?? footerPageData;
---

<footer class="ft" data-brand-footer>
  <TinaIsland name="footer-cta" wrapper={{ tag: 'div' }} params={{ slug: 'home' }}>
    <FooterCta data={footerPageData} editData={editableFooterPageData} />
  </TinaIsland>
  <div class="w"><div class="ft-t">
    {footerLogo
      ? <img src={footerLogo} alt={siteTitle} data-tina-field={seo ? tinaField(seo, 'footerLogo') : undefined} loading="lazy" decoding="async" />
      : <a href="/" aria-label={`${siteTitle} home`}>{siteTitle}</a>}
    <p data-tina-field={branding ? tinaField(branding, 'footerDescription') : undefined}>{footerDescription}</p>
  </div></div>
  <div class="w"><div class="ft-g">
    {footerColumns.map((column) => (
      <div class="ft-c">
        <h4 data-tina-field={tinaField(column, 'label')}>{column.label}</h4>
        <ul>{(column.children ?? []).filter((item): item is NavItem => Boolean(item?.label && item?.href)).map((item) => <li><a href={item.href || '#'} data-tina-field={tinaField(item, 'label')}>{item.label}</a></li>)}</ul>
      </div>
    ))}
  </div></div>
  <div class="w"><div class="ft-b"><p data-tina-field={branding ? tinaField(branding, 'copyright') : undefined}>{dynamicCopyright}</p></div></div>
</footer>
