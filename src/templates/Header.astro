---
import { tinaField } from '@tinacms/astro/tina-field';
import { getHeaderNavigation, type CmsConfig } from '../lib/data';

interface Props {
  config?: CmsConfig | null;
  navigation?: NavigationDocument | null;
}

type NavItem = {
  label?: string | null;
  href?: string | null;
  children?: (NavItem | null)[] | null;
};

type NavigationDocument = {
  title?: string | null;
  items?: (NavItem | null)[] | null;
};

const { config } = Astro.props;
let { navigation } = Astro.props;
if (!navigation && config) navigation = (await getHeaderNavigation(config)).data?.navigation ?? null;
const seo = config?.seo ?? null;
const branding = (config as any)?.branding ?? null;
const siteTitle = seo?.title || '';
const logo = seo?.logo || '';
const menuLabel = branding?.menuLabel || '';
const menuItems = ((navigation?.items ?? []) as NavItem[]).filter((item) => item?.label && item?.href);
---

<header class="mh" data-brand-header>
  <input class="ntog" id="ntog" type="checkbox" aria-label={`Toggle ${menuLabel.toLowerCase()}`} />
  <div class="w"><div class="mh-in">
    <div class="mh-l">
      <a href="/" aria-label={`${siteTitle} home`}>
        {logo
          ? <img src={logo} alt={siteTitle} data-tina-field={seo ? tinaField(seo, 'logo') : undefined} />
          : <span data-tina-field={seo ? tinaField(seo, 'title') : undefined}>{siteTitle}</span>}
      </a>
    </div>
    <label class="brg" for="ntog"><span class="brg-b" aria-hidden="true"><i></i><i></i><i></i></span><span data-tina-field={branding ? tinaField(branding, 'menuLabel') : undefined}>{menuLabel}</span></label>
    <nav class="mnav" aria-label={navigation?.title || 'Primary menu'}>
      {menuItems.map((item) => <a href={item.href || '#'} data-tina-field={tinaField(item, 'label')}>{item.label}</a>)}
    </nav>
  </div></div>
</header>
