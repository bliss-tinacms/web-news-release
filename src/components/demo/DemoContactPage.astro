---
import { tinaField } from '@tinacms/astro/tina-field';
import EmailLink from '../ui/EmailLink.astro';

const { data } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks.find((item: any) => item?._template === 'contactMockup17' || item?.__typename === 'PageBlocksContactMockup17') : null;
const hero = block?.hero || {};
const form = block?.formSection || {};
const hasAction = typeof form.formAction === 'string' && form.formAction.trim().length > 0;
---

<main class="mockup31-contact">
  <header class="ph">
    <div class="ph-l">
      <div class="ph-k" data-tina-field={hero ? tinaField(hero, 'eyebrow') : undefined}>{hero.eyebrow}</div>
      <h1 data-tina-field={hero ? tinaField(hero, 'headline') : undefined}>{hero.headline}</h1>
      <p class="ph-d" data-tina-field={hero ? tinaField(hero, 'lede') : undefined}>{hero.lede}</p>
    </div>
    <div class="ph-r">
      <div class="ph-row"><span class="ph-rk">Newsroom</span><span class="ph-rv" data-tina-field={hero ? tinaField(hero, 'newsroomEmail') : undefined}><EmailLink email={hero.newsroomEmail} /></span></div>
      <div class="ph-row"><span class="ph-rk">General</span><span class="ph-rv" data-tina-field={hero ? tinaField(hero, 'generalEmail') : undefined}><EmailLink email={hero.generalEmail} /></span></div>
      <div class="ph-row"><span class="ph-rk">Typical reply</span><span class="ph-rv" data-tina-field={hero ? tinaField(hero, 'replyTime') : undefined}>{hero.replyTime}</span></div>
    </div>
  </header>
  <section class="fm"><div class="w"><div class="fm-in">
    <div class="fm-l">
      <div class="eye"><i></i><span data-tina-field={form ? tinaField(form, 'eyebrow') : undefined}>{form.eyebrow}</span></div>
      <h2 data-tina-field={form ? tinaField(form, 'title') : undefined}>{form.title}</h2>
      <p data-tina-field={form ? tinaField(form, 'description') : undefined}>{form.description}</p>
      <div class="fm-sp">
        <div><b>Goes to</b><span data-tina-field={form ? tinaField(form, 'goesTo') : undefined}>{form.goesTo}</span></div>
        <div><b>Read by</b><span data-tina-field={form ? tinaField(form, 'readBy') : undefined}>{form.readBy}</span></div>
        <div><b>Reply window</b><span data-tina-field={form ? tinaField(form, 'replyWindow') : undefined}>{form.replyWindow}</span></div>
      </div>
    </div>
    <form class="fm-r" action={hasAction ? form.formAction : undefined} method={hasAction ? 'POST' : undefined} onsubmit={!hasAction ? 'return false' : undefined}>
      {form.subject && <input type="hidden" name="_subject" value={form.subject} />}
      <div class="fr2">
        <div class="fgr"><label class="flb" for="contact-first-name">First name <i>Required</i></label><input id="contact-first-name" class="fin" name="firstName" type="text" placeholder="First name" required /></div>
        <div class="fgr"><label class="flb" for="contact-last-name">Last name <i>Required</i></label><input id="contact-last-name" class="fin" name="lastName" type="text" placeholder="Last name" required /></div>
      </div>
      <div class="fr2">
        <div class="fgr"><label class="flb" for="contact-email">Email <i>Required</i></label><input id="contact-email" class="fin" name="email" type="email" placeholder="you@example.com" required /></div>
        <div class="fgr"><label class="flb" for="contact-phone">Phone <i>Optional</i></label><input id="contact-phone" class="fin" name="phone" type="tel" placeholder="(000) 000-0000" /></div>
      </div>
      <div class="fgr"><label class="flb" for="contact-message">Message <i>Required</i></label><textarea id="contact-message" class="fin" name="message" placeholder="Your tip, the correction, or what you would like to pitch" required></textarea></div>
      <button class="fbt" type="submit" data-tina-field={form ? tinaField(form, 'buttonText') : undefined}>{form.buttonText}</button>
      <p class="fnt" data-tina-field={form ? tinaField(form, 'note') : undefined}>{form.note}</p>
    </form>
  </div></div></section>
</main>
