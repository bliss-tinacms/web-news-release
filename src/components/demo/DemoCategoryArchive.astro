---
import { getBlogPermalink } from '../../lib/permalinks';
import FormattedDate from '../FormattedDate.astro';
import { tinaField } from '@tinacms/astro/tina-field';

const { archiveTitle = 'Category', posts = [], currentPage = 1, totalPages = 1, basePath = '/', category = null, totalStories = posts.length } = Astro.props;
function refs(post: any) {
  const values = Array.isArray(post?.categories) && post.categories.length ? post.categories.map((item: any) => typeof item === 'string' ? item : item?.category).filter(Boolean) : post?.category ? [post.category] : [];
  return values;
}
function label(reference: any) {
  if (!reference) return '';
  if (typeof reference === 'string') return reference.split('/').pop()?.replace(/\.(json|mdx?)$/i, '').replace(/[-_]+/g, ' ') || '';
  return reference.title || reference.name || reference._sys?.filename || '';
}
function postImageAlt(post: any) { return post?.heroImageAlt || post?.title || 'Story image'; }
function pageHref(page: number) { return page <= 1 ? `${basePath}/` : `${basePath}/page/${page}/`; }
const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1);
---

<main class="mockup31-category">
  <header class="ph">
    <div class="ph-l">
      <div class="ph-k">Category archive</div>
      <h1 data-tina-field={category ? tinaField(category, 'title') : undefined}>{archiveTitle}</h1>
    </div>
    <div class="ph-r"><div class="ph-row"><span class="ph-rk">Stories filed</span><span class="ph-rv">{totalStories}</span></div></div>
  </header>
  <section class="arch"><div class="w">
    <div class="eye"><i></i><span>Most recent first</span></div>
    <div class="lg">
      {posts.length > 0 ? posts.map((post: any, index: number) => {
        const categoryLabel = label(refs(post)[0]) || archiveTitle;
        return <a href={getBlogPermalink(post)} class="lr">
          <div class="lr-n">{String((currentPage - 1) * 30 + index + 1).padStart(2, '0')}</div>
          {post.heroImage && <img class="lr-img" src={post.heroImage} alt={postImageAlt(post)} />}
          <div>
            <div class="lr-m"><span class="lr-k">{categoryLabel}</span>{post.pubDate && <span class="lr-dt"><FormattedDate date={new Date(post.pubDate)} /></span>}</div>
            <div class="lr-h">{post.title || 'Untitled story'}</div>
            {post.description && <p class="lr-x">{post.description}</p>}
          </div>
        </a>;
      }) : <div class="empty-archive"><p>No stories have been filed in this category yet.</p><a class="empty-archive__link" href="/">Read the latest stories</a></div>}
    </div>
  </div></section>
  {totalPages > 1 && <section class="pg"><div class="pg-in">
    {pageNumbers.map((page) => <a href={pageHref(page)} class={page === currentPage ? 'on' : undefined} aria-current={page === currentPage ? 'page' : undefined}>{page}</a>)}
    {currentPage < totalPages && <a href={pageHref(currentPage + 1)} class="nx">Next</a>}
  </div></section>}
</main>
