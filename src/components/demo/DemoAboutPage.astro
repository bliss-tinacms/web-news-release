---
import { tinaField } from 'tinacms/dist/react';
import '../../styles/about-mockup-31.css';

const { data } = Astro.props;
const blocks: any[] = Array.isArray(data?.blocks) ? data.blocks : [];
const block: any = blocks.find(
  (item: any) => item?._template === 'aboutMockup17' || item?.__typename === 'PageBlocksAboutMockup17',
) ?? {};
const publicationHeader: any = block.publicationHeader ?? {};
const facts: any[] = Array.isArray(publicationHeader.facts) ? publicationHeader.facts : [];
const sections: any[] = Array.isArray(block.documentSections) ? block.documentSections : [];
---

<div class="about31-host">
  <header class="ph" data-tina-field={tinaField(block, 'publicationHeader')}>
    <div class="ph-l">
      <div class="ph-k" data-tina-field={tinaField(publicationHeader, 'eyebrow')}>{publicationHeader.eyebrow}</div>
      <h1 data-tina-field={tinaField(publicationHeader, 'headline')}>{publicationHeader.headline}</h1>
      <p class="ph-d" data-tina-field={tinaField(publicationHeader, 'description')}>{publicationHeader.description}</p>
    </div>
    <div class="ph-r" data-tina-field={tinaField(publicationHeader, 'facts')}>
      {facts.map((fact: any) => (
        <div class="ph-row">
          <span class="ph-rk" data-tina-field={tinaField(fact, 'label')}>{fact.label}</span>
          <span class="ph-rv" data-tina-field={tinaField(fact, 'value')}>{fact.value}</span>
        </div>
      ))}
    </div>
  </header>

  <div class="w"><div class="doc">
    <nav class="idx" data-tina-field={tinaField(block, 'documentSections')}>
      {sections.map((section: any, index: number) => (
        <a href={`#s${index + 1}`}>
          <b data-tina-field={tinaField(section, 'number')}>{section.number}</b>
          <span data-tina-field={tinaField(section, 'navTitle')}>{section.navTitle}</span>
        </a>
      ))}
    </nav>
    <div>
      {sections.map((section: any, index: number) => {
        const paragraphs: any[] = Array.isArray(section.paragraphs) ? section.paragraphs : [];
        const principles: any[] = Array.isArray(section.principles) ? section.principles : [];
        return (
          <section class="sec" id={`s${index + 1}`}>
            <div class="sec-k" data-tina-field={tinaField(section, 'sectionLabel')}>{section.sectionLabel}</div>
            <h2 data-tina-field={tinaField(section, 'title')}>{section.title}</h2>
            {section.lead && <p class="lead" data-tina-field={tinaField(section, 'lead')}>{section.lead}</p>}
            {paragraphs.map((paragraph: any) => (
              <p data-tina-field={tinaField(paragraph, 'text')}>{paragraph.text}</p>
            ))}
            {principles.length > 0 && (
              <div class="prin" data-tina-field={tinaField(section, 'principles')}>
                {principles.map((principle: any) => (
                  <div>
                    <b data-tina-field={tinaField(principle, 'number')}>{principle.number}</b>
                    <p data-tina-field={tinaField(principle, 'text')}>{principle.text}</p>
                  </div>
                ))}
              </div>
            )}
            {section.note && (
              <div class="note"><p data-tina-field={tinaField(section, 'note')}>{section.note}</p></div>
            )}
          </section>
        );
      })}
    </div>
  </div></div>
</div>
