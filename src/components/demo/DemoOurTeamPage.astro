---
import { tinaField } from '@tinacms/astro/tina-field';
const { data } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks.find((item: any) => item?._template === 'ourTeamMockup17' || item?.__typename === 'PageBlocksOurTeamMockup17') : null;
const hero = block?.hero || {};
const leaders = Array.isArray(block?.leadership?.people) ? block.leadership.people : [];
const staff = Array.isArray(block?.seniorStaff?.people) ? block.seniorStaff.people : [];
function archiveUrl(person: any) { return person?.authorSlug ? `/author/${String(person.authorSlug).replace(/^\/+|\/+$/g, '')}/` : '#'; }
---

<main class="mockup31-team">
  <header class="ph">
    <div class="ph-l">
      <div class="ph-k" data-tina-field={hero ? tinaField(hero, 'eyebrow') : undefined}>{hero.eyebrow}</div>
      <h1 data-tina-field={hero ? tinaField(hero, 'headline') : undefined}>{hero.headline}</h1>
      <p class="ph-d" data-tina-field={hero ? tinaField(hero, 'lede') : undefined}>{hero.lede}</p>
    </div>
    <div class="ph-r">
      {leaders[0] && <div class="ph-row"><span class="ph-rk">{leaders[0].role || 'Publisher'}</span><span class="ph-rv">{leaders[0].name}</span></div>}
      {leaders[1] && <div class="ph-row"><span class="ph-rk">{leaders[1].role || 'Editor-in-Chief'}</span><span class="ph-rv">{leaders[1].name}</span></div>}
      <div class="ph-row"><span class="ph-rk">Senior editors</span><span class="ph-rv">{staff.length}</span></div>
    </div>
  </header>
  <section class="lead-b"><div class="w">
    <div class="eye"><i></i><span data-tina-field={block?.leadership ? tinaField(block.leadership, 'eyebrow') : undefined}>{block?.leadership?.eyebrow}</span></div>
    <div class="lead-in">
      {leaders.map((person: any, index: number) => <div class="lp" data-tina-field={tinaField(block.leadership.people, index)}>
        {person.image && <img class="lp-img" src={person.image} alt={person.imageAlt || person.name || ''} />}
        <div class="lp-b">
          <div class="lp-rank"><b>{String(index + 1).padStart(2, '0')}</b><i></i><span>{person.tagline}</span></div>
          <div class="lp-n">{person.name}</div>
          <div class="lp-r">{[person.role, person.location].filter(Boolean).join(' · ')}</div>
          <p class="lp-x">{person.bio}</p>
        </div>
        <div class="lp-f">
          <h4>{person.recordTitle || 'On the record'}</h4>
          {(Array.isArray(person.records) ? person.records : []).map((record: any) => <div class="lp-fr"><span class="lp-fk">{record.label}</span><span class="lp-fv">{record.value}</span></div>)}
        </div>
      </div>)}
    </div>
  </div></section>
  <section class="desk"><div class="w">
    <div class="desk-h"><div><div class="eye"><i></i><span data-tina-field={block?.seniorStaff ? tinaField(block.seniorStaff, 'eyebrow') : undefined}>{block?.seniorStaff?.eyebrow}</span></div><div class="h2" data-tina-field={block?.seniorStaff ? tinaField(block.seniorStaff, 'title') : undefined}>{block?.seniorStaff?.title}</div></div></div>
    {staff.map((person: any, index: number) => <a href={archiveUrl(person)} class="dr" data-tina-field={tinaField(block.seniorStaff.people, index)}>
      <div class="dr-n">{String(leaders.length + index + 1).padStart(2, '0')}</div>
      {person.image && <img class="dr-img" src={person.image} alt={person.imageAlt || person.name || ''} />}
      <div><div class="dr-nm">{person.name}</div><div class="dr-r">{[person.role, person.location].filter(Boolean).join(' · ')}</div></div>
      <p class="dr-x">{person.bio}</p>
    </a>)}
  </div></section>
</main>
