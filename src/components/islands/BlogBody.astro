---
import { statSync } from 'node:fs';
import { join } from 'node:path';
import { getBlogPermalink } from '../../lib/permalinks';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsBlog } from '../../lib/data';
import FormattedDate from '../FormattedDate.astro';
import { mdxComponents } from '../mdx/components';

interface Props {
  data?: CmsBlog | null;
  relatedPosts?: CmsBlog[];
}

const { data, relatedPosts = [] } = Astro.props;

type ReferenceObject = {
  title?: string | null;
  name?: string | null;
  _sys?: { filename?: string | null } | null;
};
type AuthorObject = ReferenceObject & {
  role?: string | null;
  avatar?: string | null;
  bio?: string | null;
  email?: string | null;
};

function referenceItems(reference: unknown): unknown[] {
  return Array.isArray(reference) ? reference.filter(Boolean) : reference ? [reference] : [];
}
function referenceLabel(reference: unknown) {
  if (!reference) return '';
  if (typeof reference === 'string') return reference.split('/').pop()?.replace(/\.(json|mdx?)$/i, '').replace(/[-_]+/g, ' ') || '';
  const item = reference as ReferenceObject;
  return String(item.title || item.name || item._sys?.filename || '');
}
function referenceSlug(reference: unknown) {
  if (!reference) return '';
  if (typeof reference === 'string') return reference.split('/').pop()?.replace(/\.(json|mdx?)$/i, '') || '';
  const item = reference as ReferenceObject;
  return String(item._sys?.filename || item.title || item.name || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
}
function postCategories(post?: Partial<CmsBlog> | null) {
  const categories = (post as any)?.categories;
  if (Array.isArray(categories) && categories.length) return categories.map((item) => typeof item === 'string' ? item : item?.category).filter(Boolean);
  return referenceItems((post as any)?.category);
}
function fallbackPublishedDate(post?: CmsBlog | null) {
  if (!post?._sys?.filename) return new Date();
  try { return statSync(join(process.cwd(), 'src', 'content', 'blog', `${post._sys.filename}.mdx`)).mtime; }
  catch { return new Date(); }
}
function postUrl(post: CmsBlog) { return getBlogPermalink(post); }

const author = data?.author && typeof data.author === 'object' ? data.author as AuthorObject : null;
const authorName = referenceLabel(data?.author) || 'Site Staff';
const authorSlug = referenceSlug(data?.author);
const authorArchiveUrl = authorSlug ? `/author/${authorSlug}/` : '/about/';
const categories = postCategories(data).map((category) => ({ label: referenceLabel(category), slug: referenceSlug(category) })).filter((item) => item.label);
const publishedDate = data?.pubDate ? new Date(data.pubDate) : fallbackPublishedDate(data);
const heroImageAlt = (data as any)?.heroImageAlt || data?.title || 'Article lead image';
---

{data && (
  <div class="mockup31-single">
    <div class="w">
      <header class="ah">
        <h1 data-tina-field={tinaField(data, 'title')}>{data.title}</h1>
        {data.description && <p class="ah-d" data-tina-field={tinaField(data, 'description')}>{data.description}</p>}
        <div class="ah-by">
          <div><span class="ah-bk">Written by</span><span class="ah-bv" data-tina-field={tinaField(data, 'author')}><a href={authorArchiveUrl}>{authorName}</a></span></div>
          <div><span class="ah-bk">Published</span><span class="ah-bv" data-tina-field={tinaField(data, 'pubDate')}><FormattedDate date={publishedDate} /></span></div>
          <div><span class="ah-bk">Updated</span><span class="ah-bv" data-tina-field={tinaField(data, 'updatedDate')}>{data.updatedDate ? <FormattedDate date={new Date(data.updatedDate)} /> : '—'}</span></div>
          {categories.length > 0 && (
            <div><span class="ah-bk">Category</span><span class="ah-bv" data-tina-field={tinaField(data, 'categories')}>
              {categories.map((category, index) => <>{index > 0 && ', '}<a href={`/${category.slug}/`}>{category.label}</a></>)}
            </span></div>
          )}
        </div>
      </header>
      <div class="pb">
        <div>
          {data.heroImage && (
            <figure class="fig" data-tina-field={tinaField(data, 'heroImage')}>
              <img src={data.heroImage} alt={heroImageAlt} />
              {(data as any).heroImageCaption && <figcaption data-tina-field={tinaField(data, 'heroImageCaption')}>{(data as any).heroImageCaption}</figcaption>}
            </figure>
          )}
          <article data-tina-field={tinaField(data, 'body')}>
            {data.body && (typeof data.body === 'string' ? <p>{data.body}</p> : <TinaMarkdown content={data.body} components={mdxComponents} />)}
          </article>
          {(data as any).correctionText && <div class="corr">
            <div class="corr-h">Correction{(data as any).correctionDate && <> · <FormattedDate date={new Date((data as any).correctionDate)} /></>}</div>
            <div class="corr-b"><p data-tina-field={tinaField(data, 'correctionText')}>{(data as any).correctionText}</p></div>
          </div>}
        </div>
        <aside class="rail">
          <div class="rb">
            <div class="rb-h">About the author</div>
            <div class="rau" data-tina-field={tinaField(data, 'author')}>
              {author?.avatar && <img src={author.avatar} alt={(data as any)?.authorAlt || authorName} />}
              <div>
                <div class="rau-n"><a href={authorArchiveUrl}>{authorName}</a></div>
                {author?.role && <div class="rau-r">{author.role}</div>}
                <p class="rau-x">{author?.bio || 'Web News Release newsroom contributor.'}</p>
              </div>
            </div>
          </div>
          <a class="egc" href="/editorial-guidelines/">
            <div class="egc-k">Our standards</div>
            <div class="egc-h">How we report and correct.</div>
            <p class="egc-x">Sourcing, attribution, anonymity, labelling, and the corrections process, set out in full.</p>
            <span class="egc-b">Editorial guidelines <i>→</i></span>
          </a>
          <div class="rnote"><p>Corrections to this piece go to editorial@webnewsrelease.com. Include the URL, the specific error, and the correct information.</p></div>
        </aside>
      </div>
    </div>
    {relatedPosts.length > 0 && (
      <section class="mr"><div class="w">
        <div class="mr-h"><div><div class="eye"><i></i><span>Keep reading</span></div><div class="h2">More from the newsroom</div></div></div>
        <div class="mr-g">
          {relatedPosts.slice(0, 5).map((post) => {
            const relatedCategories = postCategories(post);
            const label = referenceLabel(relatedCategories[0]) || 'News';
            const date = post.pubDate ? new Date(post.pubDate) : fallbackPublishedDate(post);
            return <a href={postUrl(post)} class="mrc">
              <div class="mrc-t"><span>{label}</span><em><FormattedDate date={date} /></em></div>
              <div class="mrc-h">{post.title || 'Untitled story'}</div>
              <div class="mrc-go">Read<i></i></div>
            </a>;
          })}
        </div>
      </div></section>
    )}
  </div>
)}
